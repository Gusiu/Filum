<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      A dataSync foreground service. Since Android 15 it is limited to six hours a day
      over a rolling window - BudgetTracker watches it so the system does not kill the
      transfer at a random moment.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wi-Fi lock: without it, adapter power saving cuts throughput. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      The camera reads the pairing code from the server panel. It is not required: on a
      device without one, the code is pasted instead.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name="pl.wspa.filum.app.FilumApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Filum">

        <activity
            android:name="pl.wspa.filum.app.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          WorkManager is what raises the foreground service, so the dataSync type has to be
          added to its own declaration. Without that the system refuses to raise it on
          Android 14 and newer.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

</manifest>
