@*
    Powłoka panelu. Style są wpisane wprost, bo panel ma dwie strony i nie potrzebuje
    ani biblioteki komponentów, ani potoku zasobów statycznych — jedna rzecz mniej
    do zainstalowania u użytkownika i mniej rzeczy, które mogą się nie wczytać.
*@
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Filum</title>
    <base href="/" />
    <style>
        :root {
            color-scheme: light dark;
            --tlo: #fbfbfa;
            --karta: #ffffff;
            --tekst: #1a1a18;
            --przygaszony: #6b6b66;
            --kreska: #e3e3df;
            --akcent: #2f6f4e;
            --ostrzezenie: #9a5b12;
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --tlo: #15161a;
                --karta: #1d1e23;
                --tekst: #ececea;
                --przygaszony: #9a9a94;
                --kreska: #2e3038;
                --akcent: #6fbf90;
                --ostrzezenie: #d59a4e;
            }
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--tlo);
            color: var(--tekst);
            font: 15px/1.55 "Segoe UI", system-ui, sans-serif;
        }

        main { max-width: 62rem; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

        h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
        h2 { font-size: 1.1rem; margin: 2rem 0 .75rem; font-weight: 600; }

        nav { display: flex; gap: 1rem; margin: 1rem 0 2rem; border-bottom: 1px solid var(--kreska); }
        nav a {
            padding: .5rem 0; text-decoration: none; color: var(--przygaszony);
            border-bottom: 2px solid transparent;
        }
        nav a:hover { color: var(--tekst); }
        nav a.aktywny { color: var(--tekst); border-bottom-color: var(--akcent); }

        .karta {
            background: var(--karta); border: 1px solid var(--kreska);
            border-radius: .6rem; padding: 1.1rem 1.25rem; margin-bottom: 1rem;
        }

        .pola { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1.25rem; }
        .pola dt { color: var(--przygaszony); }
        .pola dd { margin: 0; }

        .mono { font-family: Consolas, "Cascadia Mono", monospace; font-size: .9em; }
        .przygaszony { color: var(--przygaszony); }
        .ostrzezenie { color: var(--ostrzezenie); }

        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: .6rem .5rem; border-bottom: 1px solid var(--kreska); }
        th { color: var(--przygaszony); font-weight: 500; }

        button {
            font: inherit; padding: .45rem .9rem; border-radius: .4rem;
            border: 1px solid var(--kreska); background: var(--karta); color: var(--tekst);
            cursor: pointer;
        }
        button:hover { border-color: var(--akcent); }
        button.glowny { background: var(--akcent); border-color: var(--akcent); color: #fff; }

        .qr { background: #fff; padding: 1rem; border-radius: .6rem; width: max-content; }
        .qr svg { display: block; width: 15rem; height: 15rem; }

        code.kod {
            display: block; word-break: break-all; padding: .75rem;
            background: var(--tlo); border: 1px solid var(--kreska); border-radius: .4rem;
        }
    </style>
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
