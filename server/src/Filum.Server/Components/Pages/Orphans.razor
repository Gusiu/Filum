@page "/orphans/{Slug}"
@inject AdminService Admin
@rendermode InteractiveServer

<main>
    <h1>Files with no counterpart on the phone</h1>

    <nav>
        <a href="/">Status</a>
        <a href="/pairing">Pairing</a>
    </nav>

    @if (report is null)
    {
        <div class="card">
            <p>There is no report for this device yet.</p>
            <p class="muted">
                One is produced after a full reconciliation, which the phone performs
                periodically — an incremental scan knows nothing about the files it did not
                mention, so no difference can be derived from it.
            </p>
        </div>
    }
    else if (report.Count == 0)
    {
        <div class="card">
            <p>The copy matches the phone's contents — no files are without a counterpart.</p>
            <p class="muted">As of @Format.Moment(report.GeneratedAt).</p>
        </div>
    }
    else
    {
        <div class="card">
            <p>
                <strong>@report.Count</strong> files totalling
                <strong>@Format.Bytes(report.Bytes)</strong> are in the copy but no longer on
                the phone. Usually these are files that were deleted or moved elsewhere.
            </p>
            <p class="muted">
                Filum does nothing about this and never will — this is a backup, and its
                whole point is to survive a deletion on the phone. The list exists so that a
                person can make the decision, should the disk start running out of space.
                As of @Format.Moment(report.GeneratedAt).
            </p>
        </div>

        <div class="card">
            <table>
                <thead>
                <tr><th>Path on the phone</th></tr>
                </thead>
                <tbody>
                @foreach (var path in report.Paths.Take(Limit))
                {
                    <tr><td class="mono">@path</td></tr>
                }
                </tbody>
            </table>

            @if (report.Paths.Count > Limit)
            {
                <p class="muted">
                    Showing @Limit of @report.Paths.Count. The full list is in
                    <span class="mono">.filum/orphans-@(report.Session).json</span>
                    in the device's directory.
                </p>
            }
        </div>
    }
</main>

@code {
    /// <summary>How many paths we show on the page. The rest are in the report file anyway.</summary>
    private const int Limit = 500;

    [Parameter]
    public string Slug { get; set; } = "";

    private OrphanReport? report;

    protected override void OnParametersSet() => report = Admin.Orphans(Slug);
}
