@page "/"
@inject AdminService Admin
@rendermode InteractiveServer

<main>
    <h1>Filum</h1>
    <p class="muted">A backup of your phone on this computer. Nothing here is ever deleted.</p>

    <nav>
        <a href="/" class="active">Status</a>
        <a href="/pairing">Pairing</a>
    </nav>

    @if (snapshot is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="card">
            <dl class="fields">
                <dt>Server</dt>
                <dd>@snapshot.ServerName <span class="muted">version @snapshot.Version</span></dd>

                <dt>Key</dt>
                <dd class="mono">@snapshot.Pin</dd>

                <dt>Backup directory</dt>
                <dd class="mono">@snapshot.BackupRoot</dd>

                <dt>Free space</dt>
                <dd>
                    @Format.Bytes(snapshot.FreeBytes) of @Format.Bytes(snapshot.TotalBytes)
                    @if (snapshot.FreeBytes < 20L * 1024 * 1024 * 1024)
                    {
                        <span class="warning">- running low</span>
                    }
                </dd>

                <dt>Addresses</dt>
                <dd class="mono">@string.Join(", ", snapshot.Endpoints)</dd>
            </dl>
        </div>

        <h2>Devices</h2>

        @if (snapshot.Devices.Count == 0)
        {
            <div class="card">
                <p>No phone has been paired yet.</p>
                <a href="/pairing"><button class="primary">Pair a phone</button></a>
            </div>
        }
        else
        {
            <table>
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Files</th>
                    <th>Size</th>
                    <th>Last change</th>
                    <th>No counterpart</th>
                    <th>Ledger</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var entry in snapshot.Devices)
                {
                    <tr>
                        <td>
                            @entry.Label
                            @if (!entry.Enabled)
                            {
                                <span class="warning"> - disabled</span>
                            }
                            <div class="mono muted">@entry.Slug</div>
                        </td>
                        <td>@entry.FileCount</td>
                        <td>@Format.Bytes(entry.BytesStored)</td>
                        <td>@Format.Moment(entry.LastActivity)</td>
                        <td>
                            @if (entry.OrphanCount > 0)
                            {
                                <a href="@($"/orphans/{entry.Slug}")">
                                    @entry.OrphanCount (@Format.Bytes(entry.OrphanBytes))
                                </a>
                            }
                            else
                            {
                                <span class="muted">-</span>
                            }
                        </td>
                        <td>
                            @if (entry.Ledger is not { } ledger)
                            {
                                <span class="muted">-</span>
                            }
                            else if (ledger.Intact)
                            {
                                <span>@ledger.Entries entries</span>
                                <div class="muted">chain intact</div>
                            }
                            else
                            {
                                @* A broken chain is the one thing in this panel that means
                                   somebody has been at the files. It has to stand out and it
                                   has to name the entry the divergence starts from - without
                                   that, the report is an alarm nobody can act on. *@
                                <span class="warning">ledger tampered with</span>
                                <div class="muted">
                                    @if (ledger.BrokenAtSequence is { } at)
                                    {
                                        <text>from entry @at. </text>
                                    }
                                    @ledger.Problem
                                </div>
                            }
                        </td>
                        <td>
                            <button @onclick="() => Toggle(entry)">
                                @(entry.Enabled ? "Disable" : "Enable")
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            <p class="muted">
                A disabled device can no longer send anything, but the copy it has already
                made stays untouched.
            </p>
        }
    }
</main>

@code {
    private AdminStatus? snapshot;

    protected override void OnInitialized() => snapshot = Admin.Snapshot();

    private void Toggle(AdminDevice entry)
    {
        Admin.SetEnabled(entry.Pin, !entry.Enabled);
        snapshot = Admin.Snapshot();
    }
}
