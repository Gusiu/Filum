@page "/pairing"
@inject AdminService Admin
@rendermode InteractiveServer

<main>
    <h1>Pair a phone</h1>

    <nav>
        <a href="/">Status</a>
        <a href="/pairing" class="active">Pairing</a>
    </nav>

    @if (pairing is null)
    {
        <div class="card">
            <p>
                The code carries this server's key fingerprint, so once the phone has scanned
                it, it knows whom to trust - and from then on it recognises the server
                whatever address it finds it under.
            </p>
            <p class="muted">
                The code is single-use and expires after ten minutes.
            </p>
            <button class="primary" @onclick="Generate">Generate a code</button>
        </div>
    }
    else
    {
        <div class="card">
            <div class="qr">@((MarkupString)pairing.QrSvg)</div>
        </div>

        <div class="card">
            <p>
                Scan the code with the app, or paste the string below into its pairing field.
            </p>
            <code class="code">@pairing.Payload</code>
            <p class="muted">
                Valid for another @(pairing.ExpiresInSeconds / 60) minutes. Once paired, the
                phone introduces itself with its own key and the token stops being needed.
            </p>
            <button @onclick="Generate">Generate a new one</button>
        </div>
    }
</main>

@code {
    private PairingCode? pairing;

    /// <summary>
    /// The code is created only once the button is clicked.
    ///
    /// Generating one on every page visit would leave a pile of valid tokens behind after
    /// ordinary browsing of the panel - and each of them pairs an arbitrary device.
    /// </summary>
    private void Generate() => pairing = Admin.IssuePairingCode();
}
