# Normalise to LF in the repository by default.
* text=auto eol=lf

# The test vectors must be byte-for-byte identical on both sides.
# No line ending conversion - this is a contract file, not source code.
*.tsv -text

# Visual Studio and Rider expect CRLF in their project files.
*.sln text eol=crlf
*.csproj text eol=crlf
